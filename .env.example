# ---------------------------------------------------------------------------
# Nobitex MCP server configuration
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# mainnet | testnet
# testnet uses https://testnetapiv2.nobitex.ir (safe for agent testing)
NOBITEX_ENV=testnet

# Optional explicit override. Takes precedence over NOBITEX_ENV.
# NOBITEX_BASE_URL=https://testnetapiv2.nobitex.ir

# --- Authentication (choose one) -------------------------------------------
# 1) User token: Authorization: Token <token>
# NOBITEX_TOKEN=

# 2) Ed25519 API key (recommended for bots)
# NOBITEX_PUBLIC_KEY=
# NOBITEX_PRIVATE_KEY=
# Optional: force auth mode when both are set: token | key
# NOBITEX_AUTH_MODE=key

# --- Safety ----------------------------------------------------------------
# When true, only read-only operations are allowed (trades/withdrawals blocked).
NOBITEX_READ_ONLY=false

# --- Transport -------------------------------------------------------------
# stdio | streamable-http
NOBITEX_TRANSPORT=stdio
NOBITEX_HOST=127.0.0.1
NOBITEX_PORT=8000

# --- HTTP ------------------------------------------------------------------
NOBITEX_USER_AGENT=TraderBot/nobitex-mcp-1.0.0
NOBITEX_TIMEOUT=30
